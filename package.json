{
  "name": "first-depot",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "next": "^15.1.0",
    "next-pwa": "^5.6.0"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.10.13",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
